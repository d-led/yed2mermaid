<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:y="http://www.yworks.com/xml/graphml">
  <!-- Hand written fixture: it exercises palette configurations without being a copy of any yEd palette file. -->
  <key for="node" id="d6" yfiles.type="nodegraphics"/>
  <key for="edge" id="d10" yfiles.type="edgegraphics"/>
  <graph edgedefault="directed" id="G">
    <node id="p0">
      <data key="d6">
        <y:GenericNode configuration="com.yworks.flowchart.process">
          <y:Geometry height="30.0" width="90.0" x="0.0" y="0.0"/>
          <y:Fill color="#E8EEF7" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel>Process</y:NodeLabel>
        </y:GenericNode>
      </data>
    </node>
    <node id="p1">
      <data key="d6">
        <y:GenericNode configuration="com.yworks.flowchart.decision">
          <y:Geometry height="40.0" width="90.0" x="0.0" y="80.0"/>
          <y:Fill color="#E8EEF7" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel>Decision</y:NodeLabel>
        </y:GenericNode>
      </data>
    </node>
    <node id="p2">
      <data key="d6">
        <y:GenericNode configuration="com.yworks.flowchart.document">
          <y:Geometry height="40.0" width="90.0" x="0.0" y="160.0"/>
          <y:Fill color="#E8EEF7" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel>Document</y:NodeLabel>
        </y:GenericNode>
      </data>
    </node>
    <node id="p3">
      <data key="d6">
        <y:GenericNode configuration="com.yworks.flowchart.dataBase">
          <y:Geometry height="50.0" width="70.0" x="0.0" y="240.0"/>
          <y:Fill color="#E8EEF7" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel>Store</y:NodeLabel>
        </y:GenericNode>
      </data>
    </node>
    <node id="p4">
      <data key="d6">
        <y:GenericNode configuration="com.yworks.bpmn.Gateway.withShadow">
          <y:Geometry height="45.0" width="45.0" x="200.0" y="80.0"/>
          <y:Fill color="#FFFFFFE6" color2="#D4D4D4CC" transparent="false"/>
          <y:BorderStyle color="#E38B00" type="line" width="1.0"/>
          <y:NodeLabel>Gateway</y:NodeLabel>
          <y:StyleProperties>
            <y:Property class="com.yworks.yfiles.bpmn.view.BPMNTypeEnum" name="com.yworks.bpmn.type" value="GATEWAY_TYPE_PARALLEL"/>
          </y:StyleProperties>
        </y:GenericNode>
      </data>
    </node>
    <node id="p5">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry height="40.0" width="40.0" x="200.0" y="180.0"/>
          <y:Fill hasColor="false" transparent="false"/>
          <y:BorderStyle color="#000000" type="dashed" width="1.0"/>
          <y:NodeLabel>Star</y:NodeLabel>
          <y:Shape type="star8"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="g0" yfiles.foldertype="group">
      <data key="d6">
        <y:GenericGroupNode configuration="PanelNode">
          <y:Geometry height="120.0" width="160.0" x="-220.0" y="60.0"/>
          <y:Fill color="#F7F7F7" transparent="false"/>
          <y:BorderStyle color="#808080" type="dotted" width="1.0"/>
          <y:NodeLabel>Panel</y:NodeLabel>
        </y:GenericGroupNode>
      </data>
      <graph id="g0:">
        <node id="g0::n0">
          <data key="d6">
            <y:GenericNode configuration="com.yworks.flowchart.preparation">
              <y:Geometry height="35.0" width="90.0" x="-180.0" y="100.0"/>
              <y:Fill color="#E8EEF7" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel>Prepare</y:NodeLabel>
            </y:GenericNode>
          </data>
        </node>
      </graph>
    </node>
    <edge id="e0" source="p0" target="p1">
      <data key="d10">
        <y:PolyLineEdge>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="standard"/>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e1" source="p1" target="p2">
      <data key="d10">
        <y:PolyLineEdge>
          <y:LineStyle color="#000000" type="dashed" width="1.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel>alternate</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e2" source="p2" target="p3">
      <data key="d10">
        <y:PolyLineEdge>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="diamond"/>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e3" source="p1" target="g0">
      <data key="d10">
        <y:PolyLineEdge>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel>sideways</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
  </graph>
</graphml>
